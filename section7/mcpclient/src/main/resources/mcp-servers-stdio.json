{
  "mcpServers": {
    "spring-ai-mcp" : {
      "command": "java",
      "args": [
        "-jar",
        "mcpserverstdio/target/mcpserverstdio-0.0.1-SNAPSHOT.jar"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/ada1/udemy/eazybytes/mcp"
      ]
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_HOST",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}",
        "GITHUB_HOST": "https://github.com/CodeCode-123"
      }
    }
  }
}